<?xml version="1.0" encoding="utf-8"?>
<!-- Botão Home: só o nome do app e da janela que vêm para a frente. Nem o conteúdo da tela, nem as teclas
     do controle (o Home deste Fire OS não chega aos serviços de acessibilidade, e filtrar as teclas faria
     cada toque do controle passar pelo Vitro). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/home_service_description"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="0" />
